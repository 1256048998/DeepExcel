# Copy to .env and fill in. Never commit the filled-in file.

# ---- required ---------------------------------------------------------------
DEEPEXCEL_ENV=production

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing this invalidates every issued token, which is the intended way to
# force a global logout.
JWT_SECRET=

POSTGRES_PASSWORD=
POSTGRES_USER=deepexcel
POSTGRES_DB=deepexcel

# ---- first operator account -------------------------------------------------
# Created on startup if it does not already exist. There is deliberately no
# public endpoint that creates the first admin. Remove these after the first
# successful boot and change the password through the admin UI.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# ---- access control ---------------------------------------------------------
# Registration is invite-only while the product is in closed testing. Turning
# this off makes registration open to anyone who finds the URL.
REQUIRE_INVITE_CODE=true

# ---- the M6 switch ----------------------------------------------------------
# Leave EMPTY until hosted routing is actually built.
#
# Empty  -> every client is told mode="byok" and keeps using its own provider
#           key. Model traffic never touches this service.
# Set    -> clients whose entitlement says routing_mode=hosted are given this
#           base URL and a short-lived token, and their traffic is metered.
#
# Setting it without a proxy actually running behind it makes hosted users fail
# with 503 rather than silently falling back; see routers/session.py.
HOSTED_PROXY_BASE_URL=

# How long a client may cache its endpoint configuration. This is the kill
# switch granularity: access can be withdrawn within one TTL.
ENDPOINT_CONFIG_TTL_SECONDS=900

# ---- telemetry --------------------------------------------------------------
TELEMETRY_ENABLED=true
TELEMETRY_MAX_BATCH=100

# ---- admin UI ---------------------------------------------------------------
# Exact origin of the admin site, for CORS. Leave empty if the admin UI is
# served from the same origin through a reverse proxy.
ADMIN_ORIGIN=

# ---- token lifetimes --------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=2592000
